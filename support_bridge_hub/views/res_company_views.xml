<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_inherit_support_bridge" model="ir.ui.view">
        <field name="name">res.company.form.inherit.support.bridge</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Support Hub">
                    <field name="support_bridge_parent_channel_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
