<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_form_support_bridge" model="ir.ui.view">
        <field name="name">project.project.form.support.bridge</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Support Bridge" name="support_bridge"
                      groups="base.group_system">
                    <group>
                        <group string="Customer Conversation">
                            <field name="support_bridge_customer_id"
                                   options="{'no_create': True}"/>
                            <field name="support_bridge_team_id"
                                   options="{'no_create_edit': True}"
                                   required="support_bridge_customer_id"/>
                            <field name="support_bridge_channel_id" readonly="1"
                                   invisible="not support_bridge_channel_id"/>
                        </group>
                        <group string="Sharing">
                            <field name="support_bridge_shared" widget="boolean_toggle"
                                   readonly="1"/>
                            <div colspan="2">
                                <button name="action_support_bridge_share"
                                        type="object" class="btn-primary"
                                        string="Share with Customer"
                                        invisible="support_bridge_shared"
                                        confirm="This opens a chat channel for this project on the customer's side and starts delivering messages both ways. Continue?"/>
                                <button name="action_support_bridge_revoke"
                                        type="object" class="btn-secondary"
                                        string="Stop Sharing"
                                        invisible="not support_bridge_shared"
                                        confirm="Messages stop travelling both ways. Both channels and their history stay, and each side is told that sharing ended. Continue?"/>
                                <button name="action_support_bridge_regenerate"
                                        type="object" class="btn-link"
                                        string="Rotate Token"
                                        invisible="not support_bridge_shared"
                                        confirm="Use this if the connection may have been exposed. The customer keeps working without doing anything. Continue?"/>
                            </div>
                        </group>
                    </group>
                    <div class="text-muted" invisible="support_bridge_shared">
                        Pick the customer and the helpdesk team, then press Share.
                        Nothing reaches the customer until you do.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
