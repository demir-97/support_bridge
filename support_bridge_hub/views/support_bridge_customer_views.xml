<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_support_bridge_customer_list" model="ir.ui.view">
        <field name="name">support.bridge.customer.list</field>
        <field name="model">support.bridge.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_support_bridge_customer_form" model="ir.ui.view">
        <field name="name">support.bridge.customer.form</field>
        <field name="model">support.bridge.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="button_box" name="button_box">
                        <button name="action_open_projects" type="object"
                                class="oe_stat_button" icon="fa-comments-o"
                                invisible="not project_count">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Customer company name"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="api_key"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Status">
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <group string="Linked Records" invisible="not partner_id">
                        <field name="partner_id" readonly="1"/>
                        <field name="client_public_url" readonly="1"
                               placeholder="Not reachable — relies on their own polling"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_support_bridge_customer" model="ir.actions.act_window">
        <field name="name">Customer Connections</field>
        <field name="res_model">support.bridge.customer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first customer</p>
            <p>Creates a contact and a Discuss channel for this customer automatically.
               Give the generated API Key and this server's address to the customer so
               they can connect from their own Support Bridge Client settings.</p>
        </field>
    </record>

    <menuitem id="menu_support_bridge_customer_root"
              name="Support Hub"
              parent="project.menu_project_config"
              groups="base.group_system"
              sequence="90"/>

    <menuitem id="menu_support_bridge_customer"
              name="Customer Connections"
              parent="menu_support_bridge_customer_root"
              action="action_support_bridge_customer"
              sequence="1"/>

</odoo>
