<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_helpdesk_team_form_support_bridge" model="ir.ui.view">
        <field name="name">helpdesk.team.form.support.bridge</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <group string="Support Bridge" name="support_bridge"
                       groups="base.group_system"
                       invisible="not support_bridge_channel_id">
                    <field name="support_bridge_channel_id" readonly="1"/>
                    <field name="member_ids" widget="many2many_avatar_user"
                           string="Who can see these conversations"
                           readonly="1"/>
                    <div colspan="2" class="text-muted">
                        Everyone in Team Members can read and reply in every
                        project shared under this team. Change the list in
                        Automatic Assignment above; the channels follow it.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
