<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_support_bridge_connection_list" model="ir.ui.view">
        <field name="name">support.bridge.connection.list</field>
        <field name="model">support.bridge.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hub_url"/>
                <field name="state"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <record id="view_support_bridge_connection_form" model="ir.ui.view">
        <field name="name">support.bridge.connection.form</field>
        <field name="model">support.bridge.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_connect" string="Connect" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error" readonly="1"/>
                    </div>
                    <group>
                        <group string="Vendor Connection">
                            <field name="hub_url" placeholder="https://support.yourvendor.com"/>
                            <field name="api_key"/>
                        </group>
                        <group string="Team">
                            <field name="member_user_ids" widget="many2many_tags"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                    <group string="Delivery Mode">
                        <group>
                            <field name="push_enabled" widget="boolean_toggle"/>
                            <field name="public_url" placeholder="https://mycompany.odoo.com"
                                   invisible="not push_enabled" required="push_enabled"/>
                        </group>
                    </group>
                    <group string="Linked Records" invisible="not partner_id">
                        <field name="partner_id" readonly="1"/>
                        <field name="channel_id" readonly="1"/>
                    </group>
                    <notebook invisible="state != 'connected'">
                        <page string="Projects" name="projects">
                            <field name="project_ids" readonly="1">
                                <list decoration-muted="not active">
                                    <field name="name"/>
                                    <field name="team_name"/>
                                    <field name="channel_id"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Your vendor decides which projects are shared here.
                                Press Connect to pick up newly shared ones.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_support_bridge_connection" model="ir.actions.act_window">
        <field name="name">Vendor Support</field>
        <field name="res_model">support.bridge.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect to your vendor's support team</p>
            <p>Paste the Hub URL and API Key your vendor gave you, then click Connect.</p>
        </field>
    </record>

    <menuitem id="menu_support_bridge_connection"
              name="Vendor Support"
              parent="project.menu_project_config"
              action="action_support_bridge_connection"
              groups="base.group_system"
              sequence="90"/>

</odoo>
