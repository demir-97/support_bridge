<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_support_bridge_poll" model="ir.cron">
        <field name="name">Support Bridge: poll Hub for replies</field>
        <field name="model_id" ref="model_support_bridge_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_support_bridge_retry" model="ir.cron">
        <field name="name">Support Bridge: retry failed outbound messages</field>
        <field name="model_id" ref="model_support_bridge_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
